end)

task.spawn(function()
    while task.wait(0.3) do
        if autoChest then
            pcall(function()
                local chest = getNearestChest()
                if chest then
                    local p = chest:IsA("Part") and chest or chest:FindFirstChildWhichIsA("Part")
                    local root = getRoot()
                    if p and root then
                        local d = (root.Position - p.Position).Magnitude
                        if d > 5 then
                            local tw = tweenTo(p.Position + Vector3.new(0, 3, 0), 300)
                            if tw then tw.Completed:Wait() end
                            task.wait(0.2)
                        end
                        local prompt = p:FindFirstChildOfClass("ProximityPrompt") or chest:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then
                            pcall(function() fireproximityprompt(prompt) end)
                        else
                            pcall(function() root.CFrame = CFrame.new(p.Position); task.wait(0.3) end)
                        end
                        chestCount = chestCount + 1
                        chestLbl.Text = "Ruong da thu: " .. tostring(chestCount)
                        task.wait(0.5)
                    end
                end
            end)
        end
    end
end)

-- ══ FLY ══
local flyVel, flyGyro
local keys = {W=false, A=false, S=false, D=false, Space=false, Ctrl=false}

UserInputService.InputBegan:Connect(function(input)
    local k = input.KeyCode
    if k == Enum.KeyCode.W then keys.W = true
    elseif k == Enum.KeyCode.A then keys.A = true
    elseif k == Enum.KeyCode.S then keys.S = true
    elseif k == Enum.KeyCode.D then keys.D = true
    elseif k == Enum.KeyCode.Space then keys.Space = true
    elseif k == Enum.KeyCode.LeftControl then keys.Ctrl = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local k = input.KeyCode
    if k == Enum.KeyCode.W then keys.W = false
    elseif k == Enum.KeyCode.A then keys.A = false
    elseif k == Enum.KeyCode.S then keys.S = false
    elseif k == Enum.KeyCode.D then keys.D = false
    elseif k == Enum.KeyCode.Space then keys.Space = false
    elseif k == Enum.KeyCode.LeftControl then keys.Ctrl = false
    end
end)

RunService.RenderStepped:Connect(function()
    if not flyOn then
        if flyVel then flyVel:Destroy(); flyVel = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        return
    end
    pcall(function()
        local root = getRoot()
        local hum = getHum()
        if not root or not hum or hum.Health <= 0 then return end
        if not flyVel or not flyVel.Parent then
            flyVel = Instance.new("BodyVelocity")
            flyVel.MaxForce = Vector3.new(1, 1, 1) * math.huge
            flyVel.Velocity = Vector3.zero
            flyVel.Parent = root
        end
        if not flyGyro or not flyGyro.Parent then
            flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(1, 1, 1) * math.huge
            flyGyro.P = 10000
            flyGyro.CFrame = root.CFrame
            flyGyro.Parent = root
        end
        local cam = Workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local move = Vector3.zero
        if keys.W then move = move + look end
        if keys.S then move = move - look end
        if keys.A then move = move - right end
        if keys.D then move = move + right end
        if keys.Space then move = move + Vector3.new(0, 1, 0) end
        if keys.Ctrl then move = move + Vector3.new(0, -1, 0) end
        if move.Magnitude > 0 then move = move.Unit * flySpeed end
        flyVel.Velocity = move
        flyGyro.CFrame = cam.CFrame
    end)
end)

LocalPlayer.CharacterAdded:Connect(function()
    if flyVel then flyVel:Destroy(); flyVel = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
end)

