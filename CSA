                    local chestPart = chest:IsA("Part") and chest or chest:FindFirstChildWhichIsA("Part")
                    if chestPart then
                        local dist = (myRoot.Position - chestPart.Position).Magnitude
                        if dist > 5 then
                            -- Di chuyển đến rương
                            local tween = tweenToPosition(chestPart.Position + Vector3.new(0, 3, 0), 300)
                            if tween then
                                tween.Completed:Wait()
                            end
                            task.wait(0.2)
                        end

                        -- Thu thập rương
                        local prompt = chestPart:FindFirstChildOfClass("ProximityPrompt") or chest:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then
                            pcall(function()
                                fireproximityprompt(prompt)
                            end)
                        else
                            -- Touch chest
                            pcall(function()
                                myRoot.CFrame = CFrame.new(chestPart.Position)
                                task.wait(0.3)
                            end)
                        end

                        chestCollected = chestCollected + 1
                        chestStatus.Text = "Rương đã thu: " .. tostring(chestCollected)
                        task.wait(0.5)
                    end
                end
            end)
        end
    end
end)

