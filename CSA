local function isMobile()
    return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function notify(title, text, duration)
    duration = duration or 3
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration
        })
    end)
end

-- Lấy level hiện tại
local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    return 1
end

-- Tính khoảng cách
local function getDistance(target)
    if not target or not target:FindFirstChild("HumanoidRootPart") then return math.huge end
    local myRoot = Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return math.huge end
    return (myRoot.Position - target.HumanoidRootPart.Position).Magnitude
end

-- Tween di chuyển mượt
local function tweenToPosition(position, speed)
    speed = speed or 200
    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local distance = (root.Position - position).Magnitude
    local time = math.clamp(distance / speed, 0.1, 10)
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, { CFrame = CFrame.new(position) })
    tween:Play()
    return tween
end

-- Lấy NPC sống gần nhất trong Workspace
local function getNearestNPC()
    local nearest = nil
    shortestDist = math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                local enemyLevel = obj:FindFirstChild("Level") and obj.Level.Value or 1
                local myLevel = getLevel()
                -- Chỉ farm NPC trong tầm level (±20 level)
                if enemyLevel <= myLevel + 20 then
                    local dist = getDistance(obj)
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = obj
                    end
                end
            end
        end
    end
    return nearest
end

-- Lấy tất cả rương trong map
local function getNearestChest()
    local nearest = nil
    shortestDist = math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("Part")) and obj.Name:lower():match("chest") then
            local chestPart = obj:IsA("Part") and obj or obj:FindFirstChildWhichIsA("Part")
            if chestPart then
                local root = Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (root.Position - chestPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = obj
                    end
                end
            end
        end
    end
    return nearest
end

-- Tìm Quest giver gần nhất
local function getQuestGiver()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():match("quest") then
            local part = obj:FindFirstChildWhichIsA("Part") or obj:FindFirstChild("HumanoidRootPart")
            if part then return part end
        end
    end
    return nil
end

