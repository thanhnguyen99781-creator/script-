-- ══ LOGIC ══
local function getChar()
    return LocalPlayer.Character
end

local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return d.Level.Value end
    return 1
end

local function tweenTo(pos, speed)
    speed = speed or 200
    local root = getRoot()
    if not root then return end
    local dist = (root.Position - pos).Magnitude
    local t = math.clamp(dist / speed, 0.1, 8)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tw:Play()
    return tw
end

local function getBestNPC()
    local best, bestScore = nil, math.huge
    local myLvl = getLevel()
    local root = getRoot()
    if not root then return nil end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local r = obj:FindFirstChild("HumanoidRootPart")
            if hum and r and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                local el = obj:FindFirstChild("Level") and obj.Level.Value or 1
                if el <= myLvl + levelRange and el >= myLvl - levelRange then
                    local d = (root.Position - r.Position).Magnitude
                    local s = d - (el * 2)
                    if s < bestScore then bestScore = s; best = obj end
                end
            end
        end
    end
    return best
end

local function getNearestChest()
    local best, bestDist = nil, math.huge
    local root = getRoot()
    if not root then return nil end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("Part")) and obj.Name:lower():match("chest") then
            local p = obj:IsA("Part") and obj or obj:FindFirstChildWhichIsA("Part")
            if p then
                local d = (root.Position - p.Position).Magnitude
                if d < bestDist then bestDist = d; best = obj end
            end
        end
    end
    return best
end

-- VirtualUser/Input
local vUser, vInput
pcall(function() vUser = game:GetService("VirtualUser") end)
pcall(function() vInput = game:GetService("VirtualInputManager") end)

local function attackNPC(target)
    if not target then return end
    local hum = target:FindFirstChildOfClass("Humanoid")
    local root = target:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end
    local myRoot = getRoot()
    local myHum = getHum()
    if not myRoot or not myHum then return end

    local d = (myRoot.Position - root.Position).Magnitude
    if d > 12 then
        tweenTo(root.Position + Vector3.new(0, 5, 0), 250)
        task.wait(0.1)
        return
    end

    myRoot.CFrame = CFrame.lookAt(myRoot.Position, root.Position)

    -- Melee
    if vUser then
        pcall(function()
            vUser:CaptureController()
            vUser:Button1Down(Vector2.new())
            task.wait(0.05)
            vUser:Button1Up(Vector2.new())
        end)
    end

    -- Tool attack
    local tool = getChar():FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    else
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") then
                    pcall(function() myHum:EquipTool(item) end)
                    task.wait(0.05)
                    pcall(function() item:Activate() end)
                    break
                end
            end
        end
    end

    -- Skills
    if useSkill and vInput then
        for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C}) do
            pcall(function()
                vInput:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                vInput:SendKeyEvent(false, key, false, game)
            end)
        end
    end
end

local function handleQuest()
    local root = getRoot()
    if not root then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():match("quest") then
            local part = obj:FindFirstChildWhichIsA("Part") or obj:FindFirstChild("HumanoidRootPart")
            if part then
                local d = (root.Position - part.Position).Magnitude
                if d > 15 then
                    tweenTo(part.Position + Vector3.new(0, 3, 0), 200)
                    task.wait(0.2)
                    return
                end
                local prompt = part:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    pcall(function() fireproximityprompt(prompt) end)
                else
                    pcall(function()
                        game:GetService("ReplicatedStorage").Remotes.Communicator:InvokeServer("StartQuest")
                    end)
                end
                return
            end
        end
    end
end

