-- ══ UTILITY ══
local function getChar()
    return LocalPlayer.Character
end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getLevel()
    local d = LocalPlayer:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return d.Level.Value end
    return 1
end

-- CFrame teleport (instant, no flying)
local function teleportTo(pos)
    local root = getRoot()
    if not root then return end
    root.CFrame = CFrame.new(pos)
end

-- Walk to position (ground movement)
local function walkTo(pos, timeout)
    timeout = timeout or 5
    local hum = getHum()
    local root = getRoot()
    if not hum or not root then return false end
    hum:MoveTo(pos)
    local start = tick()
    while tick() - start < timeout do
        local r = getRoot()
        if not r then return false end
        local dist = (r.Position - pos).Magnitude
        if dist < 5 then return true end
        task.wait(0.1)
    end
    return false
end

-- ══ ENEMY DETECTION ══
local function getBestNPC()
    local myLvl = getLevel()
    local root = getRoot()
    if not root then return nil end

    local best, bestDist = nil, math.huge

    -- Check Workspace.Enemies (Blox Fruits standard)
    local containers = {
        Workspace:FindFirstChild("Enemies"),
        Workspace:FindFirstChild("Enemy"),
        Workspace,
    }

    for _, container in ipairs(containers) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Model") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                    if hum and r and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                        -- Get enemy level
                        local el = 1
                        local lvlObj = obj:FindFirstChild("Level")
                        if lvlObj then
                            if lvlObj:IsA("IntValue") or lvlObj:IsA("NumberValue") then
                                el = lvlObj.Value
                            elseif lvlObj:IsA("TextLabel") then
                                el = tonumber(lvlObj.Text:match("%d+")) or 1
                            end
                        end

                        -- Check level range
                        if el <= myLvl + levelRange and el >= myLvl - levelRange - 10 then
                            local d = (root.Position - r.Position).Magnitude
                            -- Prefer higher level enemies that are closer
                            local score = d - (el * 1.5)
                            if score < bestDist then
                                bestDist = score
                                best = obj
                            end
                        end
                    end
                end
            end
        end
    end

    -- If nothing in range, search wider (remove level restriction)
    if not best then
        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Model") then
                        local hum = obj:FindFirstChildOfClass("Humanoid")
                        local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                        if hum and r and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                            local d = (root.Position - r.Position).Magnitude
                            if d < bestDist then
                                bestDist = d
                                best = obj
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

-- ══ ATTACK NPC ══
local vUser, vInput
pcall(function() vUser = game:GetService("VirtualUser") end)
pcall(function() vInput = game:GetService("VirtualInputManager") end)

local function attackNPC(target)
    if not target then return end
    local hum = target:FindFirstChildOfClass("Humanoid")
    local root = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso")
    if not hum or not root or hum.Health <= 0 then return end

    local myRoot = getRoot()
    local myHum = getHum()
    if not myRoot or not myHum then return end

    local d = (myRoot.Position - root.Position).Magnitude

    -- If far, teleport close (CFrame, not tween)
    if d > 20 then
        teleportTo(root.Position + Vector3.new(0, 5, 0))
        task.wait(0.1)
        return
    end

    -- If mid-range, walk to enemy
    if d > 8 then
        walkTo(root.Position, 2)
        return
    end

    -- In attack range - face the enemy
    myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(root.Position.X, myRoot.Position.Y, root.Position.Z))

    -- Melee attack
    if vUser then
        pcall(function()
            vUser:CaptureController()
            vUser:Button1Down(Vector2.new())
            task.wait(0.05)
            vUser:Button1Up(Vector2.new())
        end)
    end

    -- Tool attack
    local tool = getChar():FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    else
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") then
                    pcall(function() myHum:EquipTool(item) end)
                    task.wait(0.05)
                    pcall(function() item:Activate() end)
                    break
                end
            end
        end
    end

    -- Skill attacks
    if useSkill and vInput then
        for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}) do
            pcall(function()
                vInput:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                vInput:SendKeyEvent(false, key, false, game)
            end)
        end
    end
end

-- ══ QUEST SYSTEM ══
local function getQuestGiver()
    local root = getRoot()
    if not root then return nil end

    -- Search for quest NPCs
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:match("quest") or name:match("giver") or name:match("npc") then
                -- Skip player characters
                if not Players:GetPlayerFromCharacter(obj) then
                    local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("Part")
                    if part then
                        local d = (root.Position - part.Position).Magnitude
                        if d < 2000 then
                            return obj, part
                        end
                    end
                end
            end
        end
    end

    -- Also check for ProximityPrompts with quest
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local promptName = obj.ObjectText or ""
            if promptName:lower():match("quest") or promptName:lower():match("nhiem") then
                local parent = obj.Parent
                local part = parent and (parent:FindFirstChildWhichIsA("Part") or parent:FindFirstChild("HumanoidRootPart"))
                if part then
                    local d = (root.Position - part.Position).Magnitude
                    if d < 2000 then
                        return parent, part
                    end
                end
            end
        end
    end

    return nil
end

local function handleQuest()
    local root = getRoot()
    if not root then return end

    local questGiver, questPart = getQuestGiver()
    if not questGiver or not questPart then return end

    local d = (root.Position - questPart.Position).Magnitude

    -- Teleport close if far
    if d > 50 then
        teleportTo(questPart.Position + Vector3.new(0, 3, 0))
        task.wait(0.2)
        return
    end

    -- Walk to quest giver
    if d > 5 then
        walkTo(questPart.Position, 3)
        return
    end

    -- Accept quest via ProximityPrompt
    local prompt = questGiver:FindFirstChildOfClass("ProximityPrompt") or questPart:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
        task.wait(0.3)
    end

    -- Also try remote (Blox Fruits specific)
    pcall(function()
        game:GetService("ReplicatedStorage").Remotes.Communicator:InvokeServer("StartQuest")
    end)
    pcall(function()
        game:GetService("ReplicatedStorage").Remotes.Communicator:InvokeServer("AcceptQuest")
    end)
end

-- ══ ISLAND ROTATION ══
local currentIslandIdx = 1
local function checkIslandRotation()
    if not autoIsland then return end

    local myLv = getLevel()
    local target = getTargetIsland()
    local root = getRoot()
    if not root then return end

    -- Check if we need to move to a new island
    local shouldChange = false
    for i, island in ipairs(islands) do
        if i > currentIslandIdx and myLv >= island.minLv then
            shouldChange = true
            currentIslandIdx = i
        end
    end

    if shouldChange then
        StatusBar.Text = " Dang chuyen dao: " .. target.name .. "..."
        teleportTo(target.pos)
        task.wait(1)
        -- Accept quest on new island
        if autoQuest then
            handleQuest()
            task.wait(0.5)
        end
        StatusBar.Text = " Da den: " .. target.name
    end
end

-- ══ CHEST DETECTION (FIXED) ══
local function getAllChests()
    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("Part")) then
            local name = obj.Name:lower()
            if name:match("chest") or name:match("ruong") or name:match("box") or name:match("crate") then
                local part = obj:IsA("Part") and obj or obj:FindFirstChildWhichIsA("Part")
                if part then
                    local root = getRoot()
                    if root then
                        local d = (root.Position - part.Position).Magnitude
                        table.insert(chests, {model = obj, part = part, dist = d})
                    end
                end
            end
        end
    end

    -- Sort by distance
    table.sort(chests, function(a, b) return a.dist < b.dist end)
    return chests
end

