-- Auto Farm Logic
local function getBestNPC()
    local bestNPC = nil
    local bestScore = math.huge
    local myLevel = getLevel()
    local myRoot = Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                -- Bỏ qua người chơi khác
                if not Players:GetPlayerFromCharacter(obj) then
                    local enemyLevel = obj:FindFirstChild("Level") and obj.Level.Value or 1
                    if enemyLevel <= myLevel + farmLevelRange and enemyLevel >= myLevel - farmLevelRange then
                        local dist = (myRoot.Position - root.Position).Magnitude
                        -- Ưu tiên: level cao nhất + khoảng cách gần nhất
                        local score = dist - (enemyLevel * 2)
                        if score < bestScore then
                            bestScore = score
                            bestNPC = obj
                        end
                    end
                end
            end
        end
    end
    return bestNPC
end

-- Tấn công NPC
local function attackNPC(target)
    if not target then return end
    local hum = target:FindFirstChildOfClass("Humanoid")
    local root = target:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end

    local myRoot = Character:FindFirstChild("HumanoidRootPart")
    local myHum = Character:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum then return end

    -- Di chuyển đến NPC
    local dist = (myRoot.Position - root.Position).Magnitude
    if dist > 12 then
        tweenToPosition(root.Position + Vector3.new(0, 5, 0), 250)
        task.wait(0.1)
        return
    end

    -- Quay mặt về NPC
    myRoot.CFrame = CFrame.lookAt(myRoot.Position, root.Position)

    -- Đánh thường
    local virtualUser = nil
    local virtualInputManager = nil

    pcall(function()
        virtualUser = game:GetService("VirtualUser")
        virtualInputManager = game:GetService("VirtualInputManager")
    end)

    -- Thử dùng VirtualUser (click attack)
    pcall(function()
        virtualUser:CaptureController()
        virtualUser:Button1Down(Vector2.new())
        task.wait(0.05)
        virtualUser:Button1Up(Vector2.new())
    end)

    -- Thử dùng tool attack (một số game cần tool)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local charTools = Character:FindFirstChildOfClass("Tool")
    
    if charTools then
        pcall(function()
            charTools:Activate()
        end)
    elseif backpack then
        -- Tìm weapon trong backpack
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                pcall(function()
                    Humanoid:EquipTool(item)
                end)
                task.wait(0.05)
                pcall(function()
                    item:Activate()
                end)
                break
            end
        end
    end

    -- Skill attack
    if attackMethod == "Skill" then
        -- Thử activate skills (Z, X, C, V, F)
        pcall(function()
            virtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
            task.wait(0.05)
            virtualInputManager:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
        end)
        pcall(function()
            virtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
            task.wait(0.05)
            virtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
        end)
    end
end

-- Auto Quest
local function handleQuest()
    local questGiver = getQuestGiver()
    if not questGiver then return end

    local myRoot = Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local dist = (myRoot.Position - questGiver.Position).Magnitude
    if dist > 15 then
        tweenToPosition(questGiver.Position + Vector3.new(0, 3, 0), 200)
        task.wait(0.2)
        return
    end

    -- Nhận quest (ProximityPrompt hoặc Touch)
    local prompt = questGiver:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    else
        -- Click dialog
        pcall(function()
            local args = { [1] = "StartQuest" }
            game:GetService("ReplicatedStorage").Remotes.Communicator:InvokeServer(unpack(args))
        end)
    end
end

